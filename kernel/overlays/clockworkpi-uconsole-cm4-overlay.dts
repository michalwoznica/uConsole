/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	compatible = "brcm,bcm2835";

	/* uConsole ADC on the CM4 carrier I2C bus. */
	fragment@0 {
		target = <&i2c1>;

		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c1_pins>;
			status = "okay";

			adc101c: adc@54 {
				compatible = "ti,adc101c";
				reg = <0x54>;
				status = "okay";
			};
		};
	};

	/* Expansion SPI bus. */
	fragment@1 {
		target = <&spi4>;

		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&spi4_pins &spi4_cs_pins>;
			cs-gpios = <&gpio 4 GPIO_ACTIVE_LOW>;
			status = "okay";

			spidev4_0: spidev@0 {
				compatible = "spidev";
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;
				spi-max-frequency = <125000000>;
				status = "okay";
			};
		};
	};

	/* Expansion UART. Kernel command-line policy is intentionally separate. */
	fragment@2 {
		target = <&uart1>;

		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&uart1_pins>;
			status = "okay";
		};
	};

	fragment@3 {
		target = <&gpio>;

		__overlay__ {
			i2c1_pins: i2c1 {
				brcm,pins = <44 45>;
				brcm,function = <6>;
			};

			spi4_pins: spi4-pins {
				brcm,pins = <6 7>;
				brcm,function = <7>;
			};

			spi4_cs_pins: spi4-cs-pins {
				brcm,pins = <4>;
				brcm,function = <1>;
			};

			uart1_pins: uart1-pins {
				brcm,pins = <14 15>;
				brcm,function = <2>;
				brcm,pull = <0 2>;
			};
		};
	};

	/* AXP22x PMIC and uConsole power rails. */
	fragment@4 {
		target = <&i2c0if>;

		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			pinctrl-0 = <&i2c0_pins>;
			pinctrl-names = "default";
			status = "okay";

			axp22x: pmic@34 {
				compatible = "x-powers,axp221";
				reg = <0x34>;
				interrupt-controller;
				#interrupt-cells = <1>;
				interrupt-parent = <&gpio>;
				interrupts = <2 IRQ_TYPE_EDGE_FALLING>;

				regulators {
					x-powers,dcdc-freq = <3000>;

					reg_dcdc3: dcdc3 {
						regulator-always-on;
						regulator-min-microvolt = <1800000>;
						regulator-max-microvolt = <1800000>;
						regulator-name = "sys-1v8";
					};

					reg_aldo1: aldo1 {
						regulator-always-on;
						regulator-min-microvolt = <3300000>;
						regulator-max-microvolt = <3300000>;
						regulator-name = "audio-vdd";
					};

					reg_aldo2: aldo2 {
						regulator-always-on;
						regulator-min-microvolt = <3300000>;
						regulator-max-microvolt = <3300000>;
						regulator-name = "display-vcc";
					};

					reg_dldo2: dldo2 {
						regulator-always-on;
						regulator-min-microvolt = <3300000>;
						regulator-max-microvolt = <3300000>;
						regulator-name = "dldo2";
					};

					reg_dldo3: dldo3 {
						regulator-always-on;
						regulator-min-microvolt = <3300000>;
						regulator-max-microvolt = <3300000>;
						regulator-name = "dldo3";
					};

					reg_dldo4: dldo4 {
						regulator-always-on;
						regulator-min-microvolt = <3300000>;
						regulator-max-microvolt = <3300000>;
						regulator-name = "dldo4";
					};
				};

				battery_power_supply: battery-power {
					compatible = "x-powers,axp221-battery-power-supply";
					monitored-battery = <&battery>;
				};

				ac_power_supply: ac-power {
					compatible = "x-powers,axp221-ac-power-supply";
				};
			};
		};
	};

	/* Preserve the proven CM4 I2C0 routing used by the PMIC. */
	fragment@5 {
		target = <&i2c0if>;

		__overlay__ {
			compatible = "brcm,bcm2708-i2c";
		};
	};

	fragment@6 {
		target-path = "/aliases";

		__overlay__ {
			i2c0 = "/soc/i2c@7e205000";
		};
	};

	/*
	 * Replaceable 2x18650 pack: defaults are fallbacks, not immutable
	 * characteristics of the uConsole carrier.
	 */
	fragment@7 {
		target-path = "/";

		__overlay__ {
			battery: battery {
				compatible = "simple-battery";
				device-chemistry = "lithium-ion";
				constant-charge-current-max-microamp = <2100000>;
				voltage-max-design-microvolt = <4200000>;
				re-charge-voltage-microvolt = <4000000>;
				voltage-min-design-microvolt = <3300000>;
				energy-full-design-microwatt-hours = <24790000>;
				charge-full-design-microamp-hours = <6700000>;
			};
		};
	};

	/* CWU50 panel on DSI1. */
	fragment@8 {
		target = <&dsi1>;

		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			port {
				dsi_out_port: endpoint {
					remote-endpoint = <&panel_dsi_port>;
				};
			};

			panel_cwu50: panel@0 {
				compatible = "cw,cwu50";
				reg = <0>;
				reset-gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
				backlight = <&ocp8178_backlight>;
				rotation = <90>;
				iovcc-supply = <&reg_dcdc3>;
				vci-supply = <&reg_aldo2>;
				status = "okay";

				port {
					panel_dsi_port: endpoint {
						remote-endpoint = <&dsi_out_port>;
					};
				};
			};
		};
	};

	/* OCP8178 backlight control on GPIO9. */
	fragment@9 {
		target-path = "/";

		__overlay__ {
			ocp8178_backlight: backlight {
				compatible = "ocp8178-backlight";
				backlight-control-gpios = <&gpio 9 GPIO_ACTIVE_HIGH>;

				/*
				 * Stage 3 expanded the user-visible range to 0..21.
				 * Level 15 maps to hardware index 16, preserving the
				 * legacy default level 5 -> hardware index 16.
				 */
				default-brightness = <15>;
			};
		};
	};

	/*
	 * Standard simple-battery properties only. Users can override fallback
	 * values to match the installed cells from config.txt.
	 */
	__overrides__ {
		batt_uah = <&battery>,"charge-full-design-microamp-hours:0";
		batt_uwh = <&battery>,"energy-full-design-microwatt-hours:0";
		vmin_uv = <&battery>,"voltage-min-design-microvolt:0";
	};
};
