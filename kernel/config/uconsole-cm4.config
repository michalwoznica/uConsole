# uConsole CM4 delta on top of Raspberry Pi bcm2711_defconfig.
#
# Keep this file small. bcm2711_defconfig remains the platform baseline;
# this fragment contains only project-required hardware support and the
# Arch userspace security feature explicitly selected by this project.

# Display path.
CONFIG_DRM=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_VC4=m
CONFIG_DRM_PANEL_CWU50=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_OCP8178=m

# AXP221 PMIC, battery, charger, regulators and power key.
CONFIG_MFD_AXP20X_I2C=m
CONFIG_AXP20X_ADC=m
CONFIG_BATTERY_AXP20X=m
CONFIG_CHARGER_AXP20X=m
CONFIG_REGULATOR=y
CONFIG_REGULATOR_AXP20X=m
CONFIG_INPUT=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_AXP20X_PEK=m

# uConsole ADC and expansion SPI device support.
CONFIG_IIO=y
CONFIG_TI_ADC081C=m
CONFIG_SPI=y
CONFIG_SPI_SPIDEV=m

# Raspberry Pi PWM audio plus project speaker switch.
CONFIG_SND=y
CONFIG_SND_BCM2835=m
CONFIG_UCONSOLE_AMP_SWITCH=m

# Modern pacman can use Landlock-based filesystem sandboxing.
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
